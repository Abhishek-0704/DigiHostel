# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# dependencies
node_modules

# build output
dist
*.tsbuildinfo

# Expo (apps/parent-mobile, apps/student-mobile) — local dev-server cache,
# machine-specific, never committed.
.expo
web-build
expo-env.d.ts

# environment / secrets
.env
.env.*
!.env.example

# test output
/coverage

# editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea

# OS
.DS_Store
Thumbs.db

# logs
npm-debug.log
yarn-error.log
