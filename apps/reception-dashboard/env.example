# Copy to .env.local locally (never commit .env*). All values below are
# placeholders only. Named "env.example" without a leading dot for the same
# reason as the repo root's and apps/parent-mobile's own env.example: this
# repo's .claude/settings.json denies read/write access to any .env* path as
# a secrets-safety guard.
#
# Every variable here is VITE_-prefixed and safe to ship inside the compiled
# browser bundle (Vite only inlines env vars that carry this exact prefix —
# https://vite.dev/guide/env-and-mode). Never add a non-VITE_ variable to
# this file for anything the app needs at runtime, and never put a
# service-role key, database credential, or any other backend-only secret
# here — those live only in the backend's own env.example (repo root),
# never in this app. Mirrors apps/parent-mobile/env.example's EXPO_PUBLIC_
# convention, adapted to Vite's own prefix.

# Supabase project (ADR-014) — client-safe publishable values only, never
# the service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# Fastify backend base URL (ADR-007) — consumed by
# @digihostel/api-client-react's fetch mutator via setApiBaseUrl()
# (packages/api-client-react/src/custom-fetch.ts,
# src/app/initialization/registerApiClient.ts). apps/api's CORS
# configuration must allow this origin (see docs/adr/ADR-023, §17 of
# docs/reception-dashboard-architecture.md) — not yet done as of this
# scaffolding pass.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Administrative session-timeout tuning (Prompt 1 §16). Optional — safe
# defaults apply when unset (15 min idle timeout, 2 min warning-before-expiry,
# src/lib/sessionTimeout/config.ts). INFERRED, not an SDD-mandated number —
# SDD Ch.17 names session timeout only qualitatively ("reduce exposure from
# unattended devices"). Uncomment to override:
# VITE_SESSION_IDLE_TIMEOUT_MINUTES=15
# VITE_SESSION_IDLE_WARNING_MINUTES=2
