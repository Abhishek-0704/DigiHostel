# Copy to .env locally (never commit .env). All values below are placeholders only.
# Named "env.example" without a leading dot for the same reason as the repo
# root's env.example: this repo's .claude/settings.json denies read/write
# access to any .env* path as a secrets-safety guard.
#
# Every variable here is EXPO_PUBLIC_-prefixed and safe to ship inside the
# compiled app bundle (Expo inlines EXPO_PUBLIC_* vars at build time — see
# https://docs.expo.dev/guides/environment-variables/). Never add a
# non-EXPO_PUBLIC_ variable to this file for anything the app needs at
# runtime, and never put a service-role key, database credential, or any
# other backend-only secret here — those live only in the backend's own
# env.example (repo root), never in this app.

# Supabase project (ADR-014) — client-safe publishable values only, never the
# service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Fastify backend base URL (ADR-007) — consumed by
# @digihostel/api-client-react's fetch mutator (packages/api-client-react/src/custom-fetch.ts).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
