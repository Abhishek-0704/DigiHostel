{
  "expo": {
    "name": "DigiHostel Parent",
    "slug": "digihostel-parent",
    "version": "0.0.0",
    "scheme": "digihostel-parent",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "DigiHostel uses Face ID to confirm it's you before approving sensitive actions, like a leave decision or removing a trusted device."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
