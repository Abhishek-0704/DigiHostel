{
  "name": "@digihostel/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:runtime-resolution": "node scripts/verify-workspace-package-resolution.mjs"
  },
  "dependencies": {
    "@digihostel/api-zod": "workspace:*",
    "@digihostel/db": "workspace:*",
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.0",
    "pino": "^9.6.0",
    "jose": "^5.9.6",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "pino-pretty": "^13.0.0",
    "@types/node": "^24.0.0"
  }
}
