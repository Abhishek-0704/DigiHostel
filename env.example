# Copy to .env locally (never commit .env). All values below are placeholders only.
# Named "env.example" without a leading dot because this repo's own
# .claude/settings.json denies read/write access to any .env* path as a
# secrets-safety guard — this file exists specifically so that guard doesn't
# have to be relaxed just to document expected variable names.

# --- Backend (apps/api) ---
PORT=8080
NODE_ENV=development

# Supabase (ADR-006 data platform; ADR-014 auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key

# Database (packages/db, Drizzle — ADR-002)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth (ADR-014 — Supabase Auth is canonical; Fastify verifies its JWTs)
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret

# Device-trust/attestation business-authorization gates layered on top of the
# Supabase session (ADR-003, ADR-014). Trusted-device validation itself needs
# no separate secret (Postgres-authoritative, not a token Fastify issues) —
# but real registration-time attestation (Google Play Integrity) does need a
# service-account credential. Absent in every environment this repository has
# been run in so far (no Google Play Console/Cloud project exists yet — see
# docs/adr/ADR-003-implementation-report.md); when unset, registration fails
# closed with an honest "not configured" error rather than a weaker check.
GOOGLE_PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=replace-with-google-cloud-project-number
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_KEY=replace-with-service-account-json-key-content

# Push notifications (ADR-010)
EXPO_ACCESS_TOKEN=replace-with-expo-access-token

# CORS (Reception Dashboard Prompt 1) — comma-separated allow-list of
# browser origins permitted to call this API with credentials. Outside
# production, unset falls back to the Reception Dashboard's own local Vite
# dev origin automatically (apps/api/src/app.ts's resolveCorsOrigins()); in
# production, unset means CORS stays closed (fail-safe) until this is set —
# no production origin is guessed. Never set to "*" for a credential-bearing
# authenticated API.
CORS_ALLOWED_ORIGINS=https://your-reception-dashboard-domain.example
