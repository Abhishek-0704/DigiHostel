# Copy to .env locally (never commit .env). All values below are placeholders only.
# Named "env.example" without a leading dot because this repo's own
# .claude/settings.json denies read/write access to any .env* path as a
# secrets-safety guard — this file exists specifically so that guard doesn't
# have to be relaxed just to document expected variable names.

# --- Backend (apps/api) ---
PORT=8080
NODE_ENV=development

# Supabase (ADR-006 data platform; ADR-014 auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key

# Database (packages/db, Drizzle — ADR-002)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth (ADR-014 — Supabase Auth is canonical; Fastify verifies its JWTs)
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret

# Device-trust/attestation business-authorization gates layered on top of the
# Supabase session (ADR-003, ADR-014) — no separate signing secret needed here;
# these are Postgres-authoritative checks, not a token Fastify issues itself.

# Push notifications (ADR-010)
EXPO_ACCESS_TOKEN=replace-with-expo-access-token
